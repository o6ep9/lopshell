{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,

  "modules-left":   ["clock", "cpu", "temperature", "custom/language"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right":  ["pulseaudio", "backlight", "battery", "custom/lobster"],

  "clock": {
    "locale": "en_US.UTF-8",
    "interval": 1,
    "format": " {:%H:%M:%S | %d.%m.%y} ",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b>{}</b>",
        "days": "{}",
        "weekdays": "<span color='#888888'>{}</span>"
      }
    }
  },

  "cpu": {
    "format": " {usage} % ",
    "interval": 2
  },

  "temperature": {
    "format": "| {temperatureC}°C  ",
    "critical-threshold": 85,
    "format-critical": "| {temperatureC}°C !  "
  },

  "custom/language": {
    "exec": "~/.config/waybar/scripts/language.sh",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  // "custom/notify": {
  //   "exec": "swaync-client -swb",
  //   "return-type": "json",
  //   "on-click": "swaync-client -t",
  //   "escape": true
  // },

  "pulseaudio": {
    "format": "   ♪ {volume}",
    "format-muted": "  ♪ 00",
    "on-click": "kitty --class volume-tui -e wiremix"
  },

  "backlight": {
    "format": " | ★ {percent}  "
  },

  "battery": {
    "interval": 5,
    "format": " [ {capacity} % ] ",
    "format-charging": " [ + {capacity} % ] ",
    "tooltip-format": "{timeTo}\n{power} W",
    "on-click": "bash ~/.config/hypr/scripts/toggle-charge-mode.sh",
    "states": { "warning": 20, "critical": 10 }
  },

  "custom/lobster": {
    "format": " 🦞 ",
    "on-click": "",
    "tooltip": false
  }
}