# --- geometry
anchor=top-right
margin=8
padding=8,12
width=320
height=120
border-size=1
border-radius=0
layer=overlay
outer-margin=0

# --- text
font=Iosevka Nerd Font Mono 9
format=<b>%s</b>\n%b
markup=1
text-alignment=left

# --- icons
icons=1
max-icon-size=24
icon-location=left

# --- behavior
default-timeout=5000
ignore-timeout=0
group-by=app-name
max-visible=5
sort=-time

# --- colors
background-color=#181825e6
text-color=#cdd6f4
border-color=#585b70

# --- urgent
[urgency=critical]
border-color=#f38ba8
default-timeout=0

# --- charge script
[app-name=lopshell-battery]
icons=0
default-timeout=2000
border-color=#a6e3a1